# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# gallery source exports: only the WebPs ship (see content/README.md)
/public/gallery/*.png
/public/gallery/*.jpg
/public/gallery/*.jpeg

# claude code: personal settings and worktrees (skills and launch.json are shared)
/.claude/settings.local.json
/.claude/worktrees/
CLAUDE.local.md

# editors
.vscode/
.idea/
